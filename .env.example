# TAAMEN 2.0 frontend
# Same-origin `/api` is proxied by Vite to http://localhost:8787.
# Use the absolute URL only when the SPA and API are on different origins
# (requires `npm run backend` and the backend CORS allow-list).
VITE_API_BASE_URL=/api
# VITE_API_BASE_URL=http://localhost:8787/api
# Official TAAMEN support defaults live in src/config/support.ts
# (+970594054750 → https://wa.me/970594054750). Override only if needed.
# VITE_TAAMEN_WHATSAPP_URL=https://wa.me/970594054750
# VITE_TAAMEN_SUPPORT_PHONE=+970594054750
#
# Advertising stays off. Set VITE_ADS_PREVIEW=true only for a local placeholder.
# Live AdSense units stay off until VITE_ADSENSE_ENABLED=true and a real slot id is set.
# Do not commit slot ids or set VITE_ADSENSE_ENABLED=true here.
# The public seller line is public/ads.txt. Do not put a publisher id in this file.
# VITE_ADS_PREVIEW=
# VITE_ADSENSE_ENABLED=
# VITE_ADSENSE_CLIENT_ID=
# VITE_ADSENSE_HOME_SLOT=
# VITE_ADSENSE_STADIUMS_SLOT=
# VITE_ADSENSE_ARCHIVE_SLOT=
# Optional second units. They stay empty unless a real slot id is set.
# VITE_ADSENSE_HOME_FOLLOW_SLOT=
# VITE_ADSENSE_STADIUMS_FOLLOW_SLOT=
# VITE_ADSENSE_ARCHIVE_FOLLOW_SLOT=
#
# EmailJS is backend-only. Do not add VITE_EMAILJS_* here.
# See backend/.env.example:
#   Service ID  service_13mkb9h
#   Public Key  7xyuge5ZLIgBevcbL
#   Contact     template_jsugxta
#   Auto Reply  template_4pj4xlm
